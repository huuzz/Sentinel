# Development placeholders only. Copy to .env and replace before non-local use.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-for-non-local-use
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:change-me-for-non-local-use@postgres:5432/sentinel
SENTINEL_ENVIRONMENT=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_BRUTE_FORCE_THRESHOLD=10
SENTINEL_BRUTE_FORCE_WINDOW_SECONDS=120
SENTINEL_PASSWORD_SPRAY_THRESHOLD=5
SENTINEL_PASSWORD_SPRAY_WINDOW_SECONDS=300
SENTINEL_API_VOLUME_THRESHOLD=30
SENTINEL_API_VOLUME_WINDOW_SECONDS=60
SENTINEL_SUSPICIOUS_SUCCESS_FAILURE_THRESHOLD=5
SENTINEL_SUSPICIOUS_SUCCESS_WINDOW_SECONDS=600
SENTINEL_JWT_SECRET=replace-with-at-least-32-random-characters
SENTINEL_ACCESS_TOKEN_MINUTES=15
SENTINEL_REFRESH_TOKEN_DAYS=7
SENTINEL_REFRESH_COOKIE_SECURE=false
SENTINEL_ML_ENABLED=true
SENTINEL_ML_MODEL_PATH=app/ml/artifacts/isolation_forest_v1.joblib
BACKEND_INTERNAL_URL=http://backend:8000
